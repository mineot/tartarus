{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "paths": {
      "@database": ["src/database/index.ts"],
      "@shared": ["src/shared/index.ts"],
      "@commands": ["src/commands/index.ts"],
    }
  },
  "include": ["src"]
}
